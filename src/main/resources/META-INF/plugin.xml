<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.kev007.intellijspringhelmenvhints</id>
    <name>Spring Helm Env Hints</name>
    <vendor>kev007</vendor>
    <description><![CDATA[
        <p><b>intellij-spring-helm-env-hints</b> is a plugin for navigating between Spring `application*.yml|yaml` configuration
        and Helm template environment variables under `templates/`</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>


    <extensions defaultExtensionNs="com.intellij">
        <gotoDeclarationHandler implementation="com.github.kev007.intellijspringhelmenvhints.navigation.EnvVarGotoHandler"/>
        <psi.referenceContributor language="yaml" implementation="com.github.kev007.intellijspringhelmenvhints.navigation.EnvVarReferenceContributor"/>
        <annotator language="yaml" implementationClass="com.github.kev007.intellijspringhelmenvhints.navigation.EnvVarAnnotator"/>

        <!-- Matches plain YAML plus the template languages that own Helm charts
             (HelmYAML / GoTemplate), whose base language is NOT a YAML dialect. -->
        <metaLanguage implementation="com.github.kev007.intellijspringhelmenvhints.navigation.YamlLikeMetaLanguage"/>

        <!-- Inline "N refs" tag next to env vars that resolve to occurrences on the opposite side -->
        <codeInsight.declarativeInlayProvider
            language="SpringHelmEnvHintsYamlLike"
            providerId="spring.helm.env.reference.count"
            implementationClass="com.github.kev007.intellijspringhelmenvhints.navigation.EnvRefCountInlayProvider"
            isEnabledByDefault="true"
            group="OTHER_GROUP"
            bundle="messages.HelmEnvHintsBundle"
            nameKey="inlay.provider.envRefCount.name"
            descriptionKey="inlay.provider.envRefCount.description"/>
        <codeInsight.inlayActionHandler
            handlerId="spring.helm.env.reference.count"
            implementationClass="com.github.kev007.intellijspringhelmenvhints.navigation.EnvRefCountActionHandler"/>


        <!-- Persistent colour settings (application-level, shared across all projects) -->
        <applicationService
            serviceImplementation="com.github.kev007.intellijspringhelmenvhints.settings.HelmEnvHintsSettings"/>

        <!-- Settings → Other Settings → Spring Helm Env Hints -->
        <projectConfigurable
            parentId="other"
            id="com.github.kev007.intellijspringhelmenvhints.settings.HelmEnvHintsConfigurable"
            displayName="Spring Helm Env Hints"
            instance="com.github.kev007.intellijspringhelmenvhints.settings.HelmEnvHintsConfigurable"/>
    </extensions>
</idea-plugin>
